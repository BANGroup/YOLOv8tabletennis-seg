# ============================================
# СОХРАНИТЬ В GIT (модель, код, документы)
# ============================================

# ✅ СОХРАНИТЬ: YOLOv8 модели и веса
# ✅ СОХРАНИТЬ: Весь код (*.py)
# ✅ СОХРАНИТЬ: Документация (*.md)
# ✅ СОХРАНИТЬ: Конфигурация (data.yaml, *.json для конфигов)
# ✅ СОХРАНИТЬ: Датасеты

# ============================================
# ИГНОРИРОВАТЬ: Видео и фото (БЕЗ датасетов)
# ============================================

# Видео файлы (результаты обработки)
results/**/*.mp4
results/**/*.MP4
results/**/*.avi
results/**/*.mov
results/**/*.mkv
results/**/*.webm
results/**/*.flv

# Исходные видео (sources/)
sources/
sources/**/*.mp4
sources/**/*.MP4
sources/**/*.avi
sources/**/*.mov

# Фото/изображения (результаты, кроме датасетов)
results/**/*.jpg
results/**/*.jpeg
results/**/*.png
results/**/*.gif
results/**/*.bmp
results/**/*.tiff

# Промежуточные кадры
results/**/extracted_frames/
results/**/extracted_frames_*/
results/**/frames/

# Аудио
*.mp3
*.wav
*.flac

# ============================================
# ИСКЛЮЧЕНИЕ: Сохранить важные JSON файлы
# ============================================

# Игнорируем JSON но сохраняем конфиги и данные анализа
*.json
!docs/FSM_analysis/fsm_logic.json
!results/data/*.json
!scripts/config/*.json
!config/agent_models.json
!.cursor/mcp.json
!.cursor/mcp.example.json
!data.yaml

# ============================================
# СОХРАНИТЬ В GIT: Датасеты (если есть)
# ============================================

# dataset/ - СОХРАНЯЕМ (содержит обучающие данные)
# dataset_backup/ - СОХРАНЯЕМ (резервная копия)
# НЕ ИГНОРИРУЮТСЯ - просто оставляем как есть
**/labels.cache

# Временный импорт датасетов (Roboflow и т.п.)
results/import_*_tmp/

